APP_NAME="HaditsSoft"
APP_PORT=8081
APP_URL="http://127.0.0.1:${APP_PORT}"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password-here

DB_CREDENTIAL="haditssoft.db?_busy_timeout=5000"
JWT_SECRET=your-jwt-secret-here

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

RECAPTCHA_KEY=

# opencode CLI is called via `opencode run --format json` (no HTTP server needed).
# Optional: model override in provider/model format (e.g. opencode/deepseek-v4-flash-free).
OPENCODE_PROVIDER_ID=opencode
OPENCODE_MODEL_ID=deepseek-v4-flash-free

# Agent for the /ai/ask endpoint (translate endpoint always uses --agent translate).
# Agents are defined in .opencode/agents/ directory.
OPENCODE_AGENT=plan

# Secret key for the cron-only translation endpoint: POST /ai/cron/translate/:kitabName?key=...
OPENCODE_CRON_KEY=your-cron-secret-key-here
