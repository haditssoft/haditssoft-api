APP_NAME="HaditsSoft"
APP_PORT=8081
APP_URL="http://127.0.0.1:${APP_PORT}"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password-here

DB_CREDENTIAL="haditssoft.db?_busy_timeout=5000"
JWT_SECRET=your-jwt-secret-here

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

RECAPTCHA_KEY=

# opencode CLI is called via `opencode run --format json --pure` (no HTTP server needed).
# Optional: model override in provider/model format. Leave empty to use opencode default model.
# Available free models (as of 2026-08): hy3-free, mimo-v2.5-free, muse-spark-1.2-contributor-free
OPENCODE_PROVIDER_ID=
OPENCODE_MODEL_ID=

# Agent used by the AI provider path (OpenAI-compatible) when an explicit agent
# is not fixed by the caller (translate always uses --agent translate,
# summarize always uses --agent summarize). Agents live in .opencode/agents/.
OPENCODE_AGENT=plan

# Secret key for the cron-only endpoints, passed as ?key=:
#   POST /ai/cron/translate/:kitabName?key=...
#   POST /ai/cron/translate/bulk/:kitabName?key=...
#   POST /ai/cron/translate/title/bulk/:kitabName?key=...
#   POST /ai/cron/summarize/:kitabName?key=...&language=Indonesia
OPENCODE_CRON_KEY=your-cron-secret-key-here

# Retry config for translation endpoint (opencode upstream can be flaky).
# OPENCODE_TRANSLATE_RETRY_COUNT: total attempts including initial call (default 3, min 1)
# OPENCODE_TRANSLATE_RETRY_DELAY: seconds between retries (default 30, min 1)
OPENCODE_TRANSLATE_RETRY_COUNT=3
OPENCODE_TRANSLATE_RETRY_DELAY=30

# Per-record AI timeout (seconds) for the summarize cron endpoint (default 90, min 1).
OPENCODE_ASK_TIMEOUT_SEC=90

# AI provider: "openai" or "opencode" (default)
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.bansosai.app/v1
# Falls back to OpenCode when the API key is missing.
OPENAI_API_KEY=bns_8a52
OPENAI_MODEL=claude-sonnet-4-5
